{
  "name": "disk-manager",
  "version": "1.0.8",
  "private": true,
  "type": "module",
  "description": "Windows disk space analysis and file cleanup",
  "author": "Cinna",
  "license": "UNLICENSED",
  "main": "desktop/main.cjs",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src desktop scripts vite.config.ts eslint.config.js",
    "format": "prettier --write src desktop scripts *.json *.ts *.js *.html",
    "format:check": "prettier --check src desktop scripts *.json *.ts *.js *.html",
    "build": "pnpm typecheck && vite build",
    "desktop": "electron .",
    "native": "pwsh -NoProfile -File scripts/build-native.ps1",
    "test": "node scripts/integration.mjs",
    "assets": "node scripts/assets.mjs",
    "package": "pwsh -NoProfile -File scripts/package.ps1"
  },
  "dependencies": {
    "@radix-ui/react-select": "2.4.1",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "local.cinna.diskmanager",
    "productName": "DiskManager",
    "copyright": "Copyright © 2026 Cinna",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": ".packaging/electron"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "assets/icon.png",
      "assets/icon.ico",
      "assets/tray.png",
      "package.json"
    ],
    "asarUnpack": [
      "desktop/win32/*.node"
    ],
    "extraResources": [
      {
        "from": "native/publish",
        "to": "native",
        "filter": [
          "DiskManager.Native.exe"
        ]
      },
      {
        "from": "THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      },
      {
        "from": "assets/icon.ico",
        "to": "app-icon-${version}.ico"
      }
    ],
    "extraFiles": [
      {
        "from": "licenses/app",
        "to": "licenses/app"
      }
    ],
    "win": {
      "target": "dir",
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "signExecutable": false
    }
  }
}
